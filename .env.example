# AI: free-tier keys from Google AI Studio and the Groq console
AI_PROVIDER=gemini
GEMINI_API_KEY=
GROQ_API_KEY=
# Checked 2026-11-01 with a live call: gemini-3.8-flash returned 504, 2.5-flash is retired.
GEMINI_MODEL=gemini-3.7-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
GROQ_TEXT_MODEL=qwen/qwen3.8-27b
GROQ_WHISPER_MODEL=whisper-large-v3
# Copy these from each provider's console
GEMINI_RPM_LIMIT=
GROQ_RPM_LIMIT=
# Seconds: how long a job waits for a request slot, and for one provider call
LLM_MAX_WAIT_S=20
LLM_TIMEOUT_S=30

# Local mode: SQLite file and a local uploads folder, no Docker needed.
# Production sets a postgresql+psycopg:// URL and object storage instead.
DATABASE_URL=sqlite:///./suryasetu.db
UPLOAD_DIR=./uploads

# Auth
JWT_SECRET=
DEMO_OTP=123456

# API
WEB_ORIGINS=http://localhost:3000
