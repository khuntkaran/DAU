# AI: free-tier keys from Google AI Studio and the Groq console
AI_PROVIDER=gemini
GEMINI_API_KEY=
GROQ_API_KEY=
# Check current names in each provider's docs
GEMINI_MODEL=gemini-3.8-flash
GROQ_TEXT_MODEL=
GROQ_WHISPER_MODEL=whisper-large-v3
# Copy these from each provider's console
GEMINI_RPM_LIMIT=
GROQ_RPM_LIMIT=

# Local mode: SQLite file and a local uploads folder, no Docker needed.
# Production sets a postgresql+psycopg:// URL and object storage instead.
DATABASE_URL=sqlite:///./suryasetu.db
UPLOAD_DIR=./uploads

# Auth
JWT_SECRET=
DEMO_OTP=123456

# API
WEB_ORIGINS=http://localhost:3000
