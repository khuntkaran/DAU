{
  "name": "suryasetu-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "verify": "npm run typecheck && npm run lint && npm run test",
    "test:e2e": "node e2e/flow.mjs",
    "api:types": "npx --yes openapi-typescript@7 ../api/openapi.json -o src/shared/api/schema.d.ts"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "lucide-react": "^1.66.0",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-leaflet": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.0",
    "@types/leaflet": "^1.9.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^10.14.0",
    "eslint-config-next": "^16.4.3",
    "jsdom": "^27.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.0",
    "vitest": "^5.0.5"
  }
}
